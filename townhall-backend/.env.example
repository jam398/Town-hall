# Server Configuration
NODE_ENV=development
PORT=3001
API_BASE_URL=http://localhost:3001

# Frontend URL (for CORS)
FRONTEND_URL=http://localhost:3000

# Sanity CMS Configuration
SANITY_PROJECT_ID=your_project_id_here
SANITY_DATASET=production
SANITY_API_VERSION=2024-01-01
SANITY_TOKEN=your_sanity_token_here

# Email Service (Resend)
RESEND_API_KEY=your_resend_api_key_here
RESEND_FROM_EMAIL=hello@townhallnewark.org

# n8n Configuration
# Base URL for n8n webhooks (for event-driven workflows)
N8N_WEBHOOK_BASE_URL=http://localhost:5678/webhook

# Discord Webhooks (configured in n8n workflows)
# Create webhooks in Discord: Channel Settings → Integrations → Webhooks → New Webhook
# These are used by n8n workflows, not directly by backend
# Events channel - Posts new event announcements
DISCORD_EVENTS_WEBHOOK_URL=https://discord.com/api/webhooks/1450577421450612898/CXmloOGMkgp0nMpuG66mjZ9zXl2zGdQTwIC5nMt1lfF5FIIT2vUxZ7mhXxVZDbaSNgqY
# Announcements channel - Posts new blog posts
DISCORD_ANNOUNCEMENTS_WEBHOOK_URL=https://discord.com/api/webhooks/1450578060155031735/1AQkOIC3YhbQlArAp3N7Sq4p_BZMu_8hQ_mM3lh751jL4CFrzd5fF9oFNsa4gS3-EZsx
# Volunteers channel - Posts new volunteer signups
DISCORD_VOLUNTEERS_WEBHOOK_URL=https://discord.com/api/webhooks/1450577707376054303/Bbf7GVoUtJxOQKiRPUHOAAEcWznCv90B_25D9FsAgU7DyIkR7CtUyvifmUTzmTbzgsOM

# HubSpot CRM
HUBSPOT_API_KEY=your_hubspot_api_key_here
HUBSPOT_PORTAL_ID=your_portal_id_here

# Rate Limiting
RATE_LIMIT_WINDOW_MS=60000
RATE_LIMIT_MAX_REQUESTS=100

# OpenAI API for AI features (Phase 3)
# Get your API key from: https://platform.openai.com/api-keys
# Estimated costs: $5-10/month with moderate usage
OPENAI_API_KEY=sk-proj-...your_openai_api_key_here
# Optional: Override default model (defaults to gpt-4o-mini)
OPENAI_MODEL=gpt-4o-mini
