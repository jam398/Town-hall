# Town Hall - Environment Variables Example
# Copy this file to .env and fill in your actual values

# ========================================
# SANITY CMS CONFIGURATION
# ========================================
SANITY_PROJECT_ID=pvm742xo
SANITY_DATASET=production
SANITY_API_VERSION=2024-01-01
SANITY_TOKEN=your_sanity_token_here

# ========================================
# EMAIL SERVICE (RESEND)
# ========================================
RESEND_API_KEY=re_your_api_key_here
RESEND_FROM_EMAIL=hello@townhallnewark.org

# ========================================
# CRM (HUBSPOT)
# ========================================
HUBSPOT_API_KEY=your_hubspot_api_key_here
HUBSPOT_PORTAL_ID=your_portal_id_here

# ========================================
# DISCORD WEBHOOKS (Optional - Phase 2.2)
# ========================================
DISCORD_WEBHOOK_EVENTS=https://discord.com/api/webhooks/your_webhook_here
DISCORD_WEBHOOK_VOLUNTEERS=https://discord.com/api/webhooks/your_webhook_here
DISCORD_WEBHOOK_GENERAL=https://discord.com/api/webhooks/your_webhook_here

# ========================================
# OPENAI (Optional - Phase 3)
# ========================================
OPENAI_API_KEY=sk-your_openai_key_here
OPENAI_MODEL=gpt-4o-mini

# ========================================
# RATE LIMITING
# ========================================
RATE_LIMIT_WINDOW_MS=60000
RATE_LIMIT_MAX_REQUESTS=100

# ========================================
# N8N WORKFLOW AUTOMATION
# ========================================
# n8n Access URL (use your domain in production)
N8N_HOST=localhost
N8N_PROTOCOL=http
WEBHOOK_URL=http://localhost:5678/

# n8n Basic Auth (CHANGE THESE IN PRODUCTION!)
N8N_BASIC_AUTH_USER=admin
N8N_BASIC_AUTH_PASSWORD=changeme123

# n8n Encryption Key (generate with: openssl rand -hex 32)
# IMPORTANT: Keep this secure and never share it!
N8N_ENCRYPTION_KEY=generate-a-secure-key-with-openssl-rand-hex-32

# Timezone (for scheduled workflows)
TZ=America/New_York

# ========================================
# N8N WEBHOOK URLs (Generated after creating workflows)
# ========================================
# These will be filled in after creating workflows in n8n UI
N8N_WEBHOOK_NEW_EVENT=
N8N_WEBHOOK_NEW_BLOG=
N8N_WEBHOOK_NEW_VOLUNTEER=
