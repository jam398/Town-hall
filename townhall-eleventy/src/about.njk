<!-- Hero Section -->
<section class="py-24 lg:py-32 bg-swiss-white border-b border-swiss-border">
  <div class="max-w-swiss mx-auto px-6 lg:px-8">
    <div class="grid lg:grid-cols-12 gap-16">
      <div class="lg:col-span-5">
        {% accentBar "red" %}
        <h1 class="text-h1 font-bold text-swiss-black mb-6">About Town Hall</h1>
      </div>
      <div class="lg:col-span-7">
        <p class="text-h3 text-swiss-black leading-relaxed">
          Town Hall is Newark's nonprofit community hub for AI education. 
          We believe everyone deserves to understand and benefit from artificial 
          intelligence—not just tech insiders.
        </p>
      </div>
    </div>
  </div>
</section>

<!-- Mission Section -->
<section class="py-24 lg:py-32 bg-swiss-black">
  <div class="max-w-swiss mx-auto px-6 lg:px-8">
    <div class="grid lg:grid-cols-12 gap-16 items-start">
      <div class="lg:col-span-5">
        {% accentBar "red" %}
        <h2 class="text-h1 font-bold text-white">Our Mission</h2>
      </div>
      <div class="lg:col-span-7">
        <p class="text-h3 text-white leading-relaxed mb-8">
          To democratize AI education in Newark by providing free, accessible 
          workshops and resources that empower our community to understand, 
          use, and shape artificial intelligence technology.
        </p>
        <p class="text-body-lg text-neutral-400">
          We started Town Hall because we saw a gap: AI was transforming 
          everything, but most educational resources were either too technical, 
          too expensive, or not designed for our community. We're changing that.
        </p>
      </div>
    </div>
  </div>
</section>

