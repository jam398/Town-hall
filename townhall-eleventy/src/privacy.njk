<!-- Hero Section -->
<section class="py-24 lg:py-32 bg-swiss-white border-b border-swiss-border">
  <div class="max-w-swiss mx-auto px-6 lg:px-8">
    {% accentBar "red" %}
    <h1 class="text-h1 font-bold text-swiss-black mb-6">Privacy Policy</h1>
    <p class="text-body-lg text-swiss-gray max-w-2xl">
      Last updated: December 2024
    </p>
  </div>
</section>

<!-- Content -->
<section class="py-24 lg:py-32">
  <div class="max-w-swiss mx-auto px-6 lg:px-8">
    <div class="max-w-3xl">
      
      <div class="mb-12">
        <h2 class="text-h2 font-bold text-swiss-black mb-4">Overview</h2>
        <p class="text-body text-swiss-gray mb-4">
          Town Hall Newark ("we," "our," or "us") is committed to protecting your privacy. 
          This Privacy Policy explains how we collect, use, and safeguard your information 
          when you visit our website or participate in our programs.
        </p>
      </div>

      <div class="mb-12">
        <h2 class="text-h2 font-bold text-swiss-black mb-4">What Data We Collect</h2>
        <p class="text-body text-swiss-gray mb-4">We collect information you provide directly:</p>
        <ul class="list-disc pl-6 space-y-2 text-body text-swiss-gray mb-4">
          <li><strong>Event Registration:</strong> Name, email, phone (optional)</li>
          <li><strong>Volunteer Applications:</strong> Name, email, interests, motivation</li>
          <li><strong>Contact Forms:</strong> Name, email, message content</li>
          <li><strong>Newsletter:</strong> Email address</li>
        </ul>
        <p class="text-body text-swiss-gray">
          We also collect anonymous analytics data (page views, general location) if you 
          consent to analytics cookies.
        </p>
      </div>

      <div class="mb-12">
        <h2 class="text-h2 font-bold text-swiss-black mb-4">How Data Is Stored</h2>
        <p class="text-body text-swiss-gray mb-4">Your data is stored securely using:</p>
        <ul class="list-disc pl-6 space-y-2 text-body text-swiss-gray">
          <li><strong>Sanity CMS:</strong> Event registrations and volunteer applications</li>
          <li><strong>HubSpot CRM:</strong> Contact information for communications</li>
          <li><strong>Plausible Analytics:</strong> Anonymous, privacy-focused analytics</li>
        </ul>
      </div>

      <div class="mb-12">
        <h2 class="text-h2 font-bold text-swiss-black mb-4">Cookies and Analytics</h2>
        <p class="text-body text-swiss-gray mb-4">
          We use cookies to remember your preferences and improve your experience:
        </p>
        <ul class="list-disc pl-6 space-y-2 text-body text-swiss-gray mb-4">
          <li><strong>Necessary cookies:</strong> Required for the website to function (e.g., remembering your cookie preferences)</li>
          <li><strong>Analytics cookies:</strong> Help us understand how visitors use our site (Plausible Analytics - privacy-focused, no personal data collected)</li>
          <li><strong>Marketing cookies:</strong> Used to deliver relevant content (currently not in use)</li>
        </ul>
        <p class="text-body text-swiss-gray">
          You can manage your cookie preferences at any time using the cookie banner 
          that appears when you first visit our site, or by clearing your browser's 
          local storage.
        </p>
      </div>

      <div class="mb-12">
        <h2 class="text-h2 font-bold text-swiss-black mb-4">How We Use Your Data</h2>
        <ul class="list-disc pl-6 space-y-2 text-body text-swiss-gray">
          <li>Send event confirmations and reminders</li>
          <li>Respond to your inquiries</li>
          <li>Send newsletters (only if you subscribe)</li>
          <li>Improve our website and programs</li>
          <li>Coordinate volunteer activities</li>
        </ul>
      </div>

      <div class="mb-12">
        <h2 class="text-h2 font-bold text-swiss-black mb-4">Your Rights</h2>
        <p class="text-body text-swiss-gray mb-4">You have the right to:</p>
        <ul class="list-disc pl-6 space-y-2 text-body text-swiss-gray mb-4">
          <li>Access the personal data we hold about you</li>
          <li>Request correction of inaccurate data</li>
          <li>Request deletion of your data</li>
          <li>Withdraw consent for marketing communications</li>
          <li>Object to processing of your data</li>
        </ul>
        <p class="text-body text-swiss-gray">
          To exercise any of these rights, contact us at 
          <a href="mailto:{{ site.email }}" class="text-swiss-red hover:underline">{{ site.email }}</a>.
        </p>
      </div>

      <div class="mb-12">
        <h2 class="text-h2 font-bold text-swiss-black mb-4">Data Retention</h2>
        <p class="text-body text-swiss-gray">
          We retain your data only as long as necessary to provide our services and 
          fulfill legal obligations. Event registration data is kept for 2 years. 
          You can request deletion at any time.
        </p>
      </div>

      <div class="mb-12">
        <h2 class="text-h2 font-bold text-swiss-black mb-4">Third-Party Services</h2>
        <p class="text-body text-swiss-gray mb-4">We use the following third-party services:</p>
        <ul class="list-disc pl-6 space-y-2 text-body text-swiss-gray">
          <li><strong>Plausible Analytics:</strong> Privacy-focused, GDPR-compliant analytics</li>
          <li><strong>HubSpot:</strong> CRM and email communications</li>
          <li><strong>Sanity:</strong> Content management</li>
          <li><strong>Discord:</strong> Community platform</li>
        </ul>
      </div>

      <div class="mb-12">
        <h2 class="text-h2 font-bold text-swiss-black mb-4">Contact Us</h2>
        <p class="text-body text-swiss-gray">
          If you have questions about this Privacy Policy or your data, contact us at:
        </p>
        <p class="text-body text-swiss-gray mt-4">
          <strong>Email:</strong> <a href="mailto:{{ site.email }}" class="text-swiss-red hover:underline">{{ site.email }}</a><br>
          <strong>Location:</strong> {{ site.location }}
        </p>
      </div>

    </div>
  </div>
</section>
