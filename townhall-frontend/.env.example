# Town Hall Frontend Environment Variables
# Copy this file to .env.local and fill in the values

# =============================================================================
# API Configuration (REQUIRED)
# =============================================================================

# Backend API URL
# - Local development: http://localhost:3001/api
# - Production (Render): https://townhall-backend.onrender.com/api
# - Replace with your actual Render URL after deployment
NEXT_PUBLIC_API_URL=http://localhost:3001/api

# =============================================================================
# Deployment URLs (set automatically by Vercel/hosting platform)
# =============================================================================

# These are typically set automatically by the hosting platform
# NEXT_PUBLIC_SITE_URL=https://your-domain.vercel.app

# =============================================================================
# Analytics (Optional)
# =============================================================================

# Plausible Analytics (privacy-friendly)
# NEXT_PUBLIC_PLAUSIBLE_DOMAIN=townhallnewark.org

# =============================================================================
# Feature Flags (Optional)
# =============================================================================

# Enable/disable features
# NEXT_PUBLIC_ENABLE_AI_FEATURES=true
